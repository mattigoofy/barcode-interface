<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="stock_quick_scan.QuickScan">
        <div class="o_action o_stock_quick_scan">
            <Layout display="display">
                <div class="o_stock_quick_scan_sheet container py-3">
                    <div class="btn-group w-100 mb-3" role="group">
                        <button
                            type="button"
                            class="btn"
                            t-att-class="state.mode === 'scrap' ? 'btn-primary' : 'btn-secondary'"
                            t-on-click="() => this.setMode('scrap')"
                        >
                            <i class="fa fa-trash-o me-1" />Scrap
                        </button>
                        <button
                            type="button"
                            class="btn"
                            t-att-class="state.mode === 'stock' ? 'btn-primary' : 'btn-secondary'"
                            t-on-click="() => this.setMode('stock')"
                        >
                            <i class="fa fa-plus me-1" />Add to Stock
                        </button>
                    </div>

                    <div class="mb-2">
                        <div class="o_wrap_field d-flex mb-2 align-items-center">
                            <label class="o_form_label o_stock_quick_scan_label">Location</label>
                            <select
                                class="form-select"
                                t-on-change="(ev) => this.setLocation(ev.target.value)"
                            >
                                <option
                                    t-foreach="state.locations"
                                    t-as="loc"
                                    t-key="loc.id"
                                    t-att-value="loc.id"
                                    t-att-selected="loc.id === state.locationId"
                                    t-esc="loc.name"
                                />
                            </select>
                        </div>
                        <t t-if="state.mode === 'scrap'">
                            <div class="o_wrap_field d-flex mb-2 align-items-center">
                                <label class="o_form_label o_stock_quick_scan_label">Scrap Location</label>
                                <select
                                    class="form-select"
                                    t-on-change="(ev) => this.setScrapLocation(ev.target.value)"
                                >
                                    <option
                                        t-foreach="state.scrapLocations"
                                        t-as="loc"
                                        t-key="loc.id"
                                        t-att-value="loc.id"
                                        t-att-selected="loc.id === state.scrapLocationId"
                                        t-esc="loc.name"
                                    />
                                </select>
                            </div>
                            <div
                                t-if="state.reasons.length"
                                class="o_wrap_field d-flex mb-2 align-items-start"
                            >
                                <label class="o_form_label o_stock_quick_scan_label">Reasons</label>
                                <div class="d-flex flex-wrap gap-1">
                                    <span
                                        t-foreach="state.reasons"
                                        t-as="reason"
                                        t-key="reason.id"
                                        class="badge rounded-pill o_stock_quick_scan_reason"
                                        t-att-class="state.reasonIds.includes(reason.id) ? 'text-bg-primary' : 'text-bg-light border'"
                                        t-on-click="() => this.toggleReason(reason)"
                                        t-esc="reason.name"
                                    />
                                </div>
                            </div>
                        </t>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-barcode" /></span>
                            <input
                                type="text"
                                class="form-control o_stock_quick_scan_input"
                                placeholder="Scan or type a barcode, then Enter"
                                t-model="state.code"
                                t-on-keydown="onCodeKeydown"
                            />
                        </div>
                        <button
                            t-if="cameraSupported"
                            type="button"
                            class="btn btn-primary"
                            title="Scan with camera"
                            t-on-click="onCameraClick"
                        >
                            <i class="fa fa-camera" />
                        </button>
                    </div>

                    <div class="text-muted small mb-2">
                        <i t-if="state.pending" class="fa fa-circle-o-notch fa-spin me-1" />
                        <t t-if="state.mode === 'scrap'">Each product scanned is scrapped at once (1 unit).</t>
                        <t t-else="">Each product scanned is added to stock at once (1 unit).</t>
                    </div>

                    <table t-if="state.log.length" class="table table-sm o_list_table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Product</th>
                                <th class="text-end">Quantity</th>
                                <th>Done</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="state.log" t-as="entry" t-key="entry.id">
                                <td class="text-muted" t-esc="entry.time" />
                                <td t-esc="entry.name" />
                                <td class="text-end"><t t-esc="entry.qty" /> <t t-esc="entry.uom" /></td>
                                <td>
                                    <span t-if="entry.mode === 'scrap'" class="badge text-bg-danger">Scrapped</span>
                                    <span t-else="" class="badge text-bg-success">Added</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </Layout>
        </div>
    </t>

</templates>
